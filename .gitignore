# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 只有「模板」可以进版本库，用来记录需要哪些变量；真实值一律不入库
!.env.webhook.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated
src/generated/

# CodeGraph local index (per-machine, rebuilt via `codegraph init`)
/.codegraph/
.gstack/
.data

# 运行时日志（爬虫/部署输出，非源码；曾误入版本库产生大量噪声 diff）
crawl.log
deploy.log
# 课程内容体检产物（每次 `pnpm run audit:content --json` 重新生成）
content-audit.json

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# 部署脚本的构建暂存目录与上一版产物（.next 原子替换用，非源码）。
# 必须忽略：server 远端的 receive.denyCurrentBranch=updateInstead 会因为
# 工作区出现未跟踪文件而拒绝推送。
/.next-staging/
/.next-prev/
# e2e 专用构建目录（CI 与本地干跑用 TYPENOW_DIST_DIR 指向它，
# 目的是不让 dev 产物覆盖生产构建的 .next）。
/.next-e2e/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 只有「模板」可以进版本库，用来记录需要哪些变量；真实值一律不入库
!.env.webhook.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated
src/generated/

# CodeGraph local index (per-machine, rebuilt via `codegraph init`)
/.codegraph/
.gstack/
.data

# 运行时日志（爬虫/部署输出，非源码；曾误入版本库产生大量噪声 diff）
crawl.log
deploy.log
# 课程内容体检产物（每次 `pnpm run audit:content --json` 重新生成）
content-audit.json

# 教材版本回填产物（每次 `npx tsx scripts/backfill-textbook-version.ts` 重新生成）。
# 与 content-audit.json 同理：内容由课程标题推导而来，按需重跑即可。
# 它里面有两份**需要人工判断**的清单（无年级的课、疑似非教材同步的课），
# 判断完就该重新生成 —— 把过期清单留在仓库里反而会误导下一个人。
content-textbook-version.json

# 数据清理脚本导出的「已删除内容」安全网（不可逆删除前留底，本地留存即可）
content-deleted/
db-backup/

# 头脑风暴可视化会话产物（本地临时）
.superpowers/

# 封面方案样例图（临时工作产物）
cover-samples/
